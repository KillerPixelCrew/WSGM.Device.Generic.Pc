<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Builds are deterministic and offline-capable; dependency alerts run in GitHub instead of
         turning an unavailable NuGet advisory endpoint into a compiler failure. -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>
